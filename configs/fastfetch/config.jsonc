{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "height": 16,
        "width": 5
    },
   "modules": [
        "break",

        {
            "type": "custom",
            "format": "  i use arch btw :3",
            "outputColor": "red"
        },

        {
            "type": "custom",
            "format": "  ┌ ★ Hardware",
            "outputColor": "green"
        },
        {
            "type": "title",
            "key": "  ├     PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "  ├󰍛    CPU",
            "showPeCoreCount": true,
            "format": "{1}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "  ├󰍛    GPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "  └󰍛 Memory",
            "keyColor": "green"
        },
        "break",

        {
            "type": "custom",
            "format": "  ┌ ♥︎ Software",
            "outputColor": "yellow"
        },
        {
            "type": "os",
            "key": "  ├       OS",
            "keyColor": "yellow",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "  ├   Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "  ├     Rice",
            "keyColor": "yellow",
            "text": "echo 'Nitrogen'"
        },
        {
            "type": "packages",
            "key": "  ├󰏖 Packages",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "  ├    Shell",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "  ├   OS Age",
            "keyColor": "yellow",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ├   Uptime",
            "keyColor": "yellow"
        }
    ]
}
